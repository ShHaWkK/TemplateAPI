{
  "name": "create-shhawk-api",
  "version": "1.0.0",
  "description": "CLI pour générer des API Node.js modulaires en TypeScript ou JavaScript avec architecture hexagonale.",
  "main": "dist/cli/index.js",
  "bin": {
    "create-shhawk-api": "dist/cli/index.js",
    "create-template-api": "dist/cli/index.js"
  },
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node src/cli/index.ts",
    "test": "npm run typecheck && npm run test:generated",
    "prepublishOnly": "npm test && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:generated": "ts-node scripts/test-generated-customizers.ts"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "keywords": [
    "cli",
    "api",
    "template",
    "scaffolding",
    "hexagonal-architecture",
    "express",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShHaWkK/TemplateAPI.git"
  },
  "bugs": {
    "url": "https://github.com/ShHaWkK/TemplateAPI/issues"
  },
  "homepage": "https://github.com/ShHaWkK/TemplateAPI#readme",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "ejs": "^3.1.10",
    "fs-extra": "^11.2.0",
    "inquirer": "^8.2.7"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^8.2.12",
    "@types/node": "^20.11.20",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
