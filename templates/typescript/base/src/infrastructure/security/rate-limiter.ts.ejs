/**
 * Advanced Rate Limiting System
 * Supports multiple strategies: fixed window, sliding window, token bucket
 */

import { ApplicationError } from '../../application/errors/application-error';

// Rate Limit Types
export interface RateLimitConfig {
  windowMs: number;
  maxRequests: number;
  strategy: RateLimitStrategy;
  keyGenerator?: (req: RateLimitRequest) => string;
  skipSuccessfulRequests?: boolean;
  skipFailedRequests?: boolean;
  standardHeaders?: boolean;
  legacyHeaders?: boolean;
  store?: RateLimitStore;
}

export type RateLimitStrategy = 'fixed-window' | 'sliding-window' | 'token-bucket';

export interface RateLimitRequest {
  ip: string;
  userId?: string;
  path: string;
  method: string;
  headers: Record<string, string | string[]>;
}

export interface RateLimitResult {
  allowed: boolean;
  limit: number;
  remaining: number;
  resetTime: Date;
  retryAfter?: number;
  headers: Record<string, string>;
}

export interface RateLimitStore {
  get(key: string): Promise<RateLimitStoreEntry | null>;
  set(key: string, entry: RateLimitStoreEntry, ttlMs: number): Promise<void>;
  delete(key: string): Promise<void>;
  reset(): Promise<void>;
}

export interface RateLimitStoreEntry {
  count: number;
  resetTime: number;
  tokens?: number;
  lastRefill?: number;
}

// Memory Store Implementation
export class MemoryRateLimitStore implements RateLimitStore {
  private store: Map<string, RateLimitStoreEntry & { expiresAt: number }> = new Map();

  async get(key: string): Promise<RateLimitStoreEntry | null> {
    this.cleanup();
    const entry = this.store.get(key);
    
    if (!entry || entry.expiresAt < Date.now()) {
      return null;
    }

    return {
      count: entry.count,
      resetTime: entry.resetTime,
      tokens: entry.tokens,
      lastRefill: entry.lastRefill,
    };
  }

  async set(key: string, entry: RateLimitStoreEntry, ttlMs: number): Promise<void> {
    this.store.set(key, {
      ...entry,
      expiresAt: Date.now() + ttlMs,
    });
  }

  async delete(key: string): Promise<void> {
    this.store.delete(key);
  }

  async reset(): Promise<void> {
    this.store.clear();
  }

  private cleanup(): void {
    const now = Date.now();
    for (const [key, entry] of this.store.entries()) {
      if (entry.expiresAt < now) {
        this.store.delete(key);
      }
    }
  }
}

// Rate Limiter Strategies
abstract class RateLimiterStrategy {
  constructor(
    protected config: RateLimitConfig,
    protected store: RateLimitStore
  ) {}

  abstract check(key: string): Promise<RateLimitResult>;

  protected createResult(
    allowed: boolean,
    limit: number,
    remaining: number,
    resetTime: Date,
    retryAfter?: number
  ): RateLimitResult {
    return {
      allowed,
      limit,
      remaining,
      resetTime,
      retryAfter,
      headers: {
        'X-RateLimit-Limit': String(limit),
        'X-RateLimit-Remaining': String(remaining),
        'X-RateLimit-Reset': String(Math.floor(resetTime.getTime() / 1000)),
        ...(retryAfter && { 'Retry-After': String(retryAfter) }),
      },
    };
  }
}

// Fixed Window Strategy
class FixedWindowStrategy extends RateLimiterStrategy {
  async check(key: string): Promise<RateLimitResult> {
    const now = Date.now();
    const windowStart = Math.floor(now / this.config.windowMs) * this.config.windowMs;
    const windowKey = `${key}:${windowStart}`;

    const entry = await this.store.get(windowKey);
    const count = entry?.count || 0;
    const resetTime = new Date(windowStart + this.config.windowMs);

    if (count >= this.config.maxRequests) {
      const retryAfter = Math.ceil((resetTime.getTime() - now) / 1000);
      return this.createResult(false, this.config.maxRequests, 0, resetTime, retryAfter);
    }

    await this.store.set(
      windowKey,
      { count: count + 1, resetTime: resetTime.getTime() },
      this.config.windowMs
    );

    return this.createResult(true, this.config.maxRequests, this.config.maxRequests - count - 1, resetTime);
  }
}

// Sliding Window Strategy
class SlidingWindowStrategy extends RateLimiterStrategy {
  async check(key: string): Promise<RateLimitResult> {
    const now = Date.now();
    const windowStart = now - this.config.windowMs;

    // In a real implementation, this would use a sorted set or similar
    // For now, we approximate with a count-based approach
    const entry = await this.store.get(key);
    const count = entry?.count || 0;
    const resetTime = new Date(now + this.config.windowMs);

    if (count >= this.config.maxRequests) {
      return this.createResult(false, this.config.maxRequests, 0, resetTime, Math.ceil(this.config.windowMs / 1000));
    }

    await this.store.set(
      key,
      { count: count + 1, resetTime: resetTime.getTime() },
      this.config.windowMs
    );

    return this.createResult(true, this.config.maxRequests, this.config.maxRequests - count - 1, resetTime);
  }
}

// Token Bucket Strategy
class TokenBucketStrategy extends RateLimiterStrategy {
  async check(key: string): Promise<RateLimitResult> {
    const now = Date.now();
    const entry = await this.store.get(key);

    let tokens = entry?.tokens ?? this.config.maxRequests;
    let lastRefill = entry?.lastRefill ?? now;

    // Calculate tokens to add based on elapsed time
    const elapsedMs = now - lastRefill;
    const tokensToAdd = (elapsedMs / this.config.windowMs) * this.config.maxRequests;
    tokens = Math.min(this.config.maxRequests, tokens + tokensToAdd);

    const resetTime = new Date(now + this.config.windowMs);

    if (tokens < 1) {
      const waitTime = Math.ceil((1 - tokens) * (this.config.windowMs / this.config.maxRequests));
      return this.createResult(false, this.config.maxRequests, 0, new Date(now + waitTime), Math.ceil(waitTime / 1000));
    }

    tokens -= 1;

    await this.store.set(
      key,
      { tokens, lastRefill: now, count: this.config.maxRequests - Math.floor(tokens), resetTime: resetTime.getTime() },
      this.config.windowMs * 2
    );

    return this.createResult(true, this.config.maxRequests, Math.floor(tokens), resetTime);
  }
}

// Main Rate Limiter Class
export class RateLimiter {
  private strategy: RateLimiterStrategy;
  private config: RateLimitConfig;

  constructor(config: RateLimitConfig) {
    this.config = {
      strategy: 'fixed-window',
      store: new MemoryRateLimitStore(),
      standardHeaders: true,
      legacyHeaders: false,
      ...config,
    };

    this.strategy = this.createStrategy(this.config.strategy);
  }

  async check(req: RateLimitRequest): Promise<RateLimitResult> {
    const key = this.getKey(req);
    return this.strategy.check(key);
  }

  async reset(key?: string): Promise<void> {
    if (key) {
      await this.config.store!.delete(key);
    } else {
      await this.config.store!.reset();
    }
  }

  getConfig(): RateLimitConfig {
    return { ...this.config };
  }

  private createStrategy(strategy: RateLimitStrategy): RateLimiterStrategy {
    const store = this.config.store!;

    switch (strategy) {
      case 'sliding-window':
        return new SlidingWindowStrategy(this.config, store);
      case 'token-bucket':
        return new TokenBucketStrategy(this.config, store);
      case 'fixed-window':
      default:
        return new FixedWindowStrategy(this.config, store);
    }
  }

  private getKey(req: RateLimitRequest): string {
    if (this.config.keyGenerator) {
      return this.config.keyGenerator(req);
    }

    // Default key generation
    if (req.userId) {
      return `user:${req.userId}`;
    }
    return `ip:${req.ip}`;
  }
}

// Factory function
export function createRateLimiter(config: RateLimitConfig): RateLimiter {
  return new RateLimiter(config);
}

// Express/Connect middleware helper
export function rateLimitMiddleware(limiter: RateLimiter) {
  return async (req: unknown, res: {
    status: (code: number) => { json: (body: unknown) => void };
    set: (headers: Record<string, string>) => void;
  }, next: () => void) => {
    try {
      const result = await limiter.check(req as RateLimitRequest);

      // Set rate limit headers
      res.set(result.headers);

      if (!result.allowed) {
        res.status(429).json({
          error: 'Too Many Requests',
          retryAfter: result.retryAfter,
        });
        return;
      }

      next();
    } catch (error) {
      // On error, allow request but log
      console.error('Rate limiter error:', error);
      next();
    }
  };
}
