/**
 * Domain Event System
 * Implements the Observer pattern for domain events
 * Enables loose coupling between domain logic and side effects
 */

export interface DomainEvent {
  readonly eventId: string;
  readonly eventType: string;
  readonly aggregateId: string;
  readonly aggregateType: string;
  readonly occurredAt: Date;
  readonly version: number;
  readonly payload: Record<string, unknown>;
}

export interface DomainEventMetadata {
  correlationId?: string;
  causationId?: string;
  userId?: string;
  source?: string;
  [key: string]: unknown;
}

export class DomainEventBuilder {
  private event: Partial<DomainEvent> = {
    eventId: this.generateId(),
    occurredAt: new Date(),
    version: 1,
    payload: {},
  };
  private metadata: DomainEventMetadata = {};

  static create(): DomainEventBuilder {
    return new DomainEventBuilder();
  }

  withType(eventType: string): this {
    this.event.eventType = eventType;
    return this;
  }

  withAggregate(aggregateId: string, aggregateType: string): this {
    this.event.aggregateId = aggregateId;
    this.event.aggregateType = aggregateType;
    return this;
  }

  withPayload(payload: Record<string, unknown>): this {
    this.event.payload = { ...this.event.payload, ...payload };
    return this;
  }

  withVersion(version: number): this {
    this.event.version = version;
    return this;
  }

  withMetadata(metadata: DomainEventMetadata): this {
    this.metadata = { ...this.metadata, ...metadata };
    return this;
  }

  build(): DomainEvent {
    if (!this.event.eventType) {
      throw new Error('Event type is required');
    }
    if (!this.event.aggregateId) {
      throw new Error('Aggregate ID is required');
    }

    return {
      ...this.event,
      payload: {
        ...this.event.payload,
        _metadata: this.metadata,
      },
    } as DomainEvent;
  }

  private generateId(): string {
    return `${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;
  }
}

// Event Handler Types
type EventHandler<T extends DomainEvent = DomainEvent> = (event: T) => Promise<void> | void;
type EventFilter = (event: DomainEvent) => boolean;

interface EventSubscription {
  id: string;
  handler: EventHandler;
  filter?: EventFilter;
  once?: boolean;
}

// Event Bus Implementation
export class EventBus {
  private subscriptions: Map<string, EventSubscription[]> = new Map();
  private middlewares: Array<(event: DomainEvent, next: () => Promise<void>) => Promise<void>> = [];
  private history: DomainEvent[] = [];
  private maxHistorySize: number;

  constructor(options: { maxHistorySize?: number } = {}) {
    this.maxHistorySize = options.maxHistorySize ?? 1000;
  }

  use(middleware: (event: DomainEvent, next: () => Promise<void>) => Promise<void>): this {
    this.middlewares.push(middleware);
    return this;
  }

  subscribe(
    eventType: string,
    handler: EventHandler,
    options: { filter?: EventFilter; once?: boolean } = {}
  ): () => void {
    const subscription: EventSubscription = {
      id: `${eventType}-${Date.now()}-${Math.random()}`,
      handler,
      filter: options.filter,
      once: options.once,
    };

    if (!this.subscriptions.has(eventType)) {
      this.subscriptions.set(eventType, []);
    }
    this.subscriptions.get(eventType)!.push(subscription);

    return () => this.unsubscribe(eventType, subscription.id);
  }

  subscribeAll(handler: EventHandler, options: { filter?: EventFilter } = {}): () => void {
    const subscriptionId = `all-${Date.now()}-${Math.random()}`;
    
    // Subscribe to all event types
    const unsubscribers: (() => void)[] = [];
    
    const wrappedHandler = async (event: DomainEvent) => {
      if (!options.filter || options.filter(event)) {
        await handler(event);
      }
    };

    // Store the handler for all events
    this.subscriptions.set(subscriptionId, [{
      id: subscriptionId,
      handler: wrappedHandler,
    }]);

    return () => {
      this.subscriptions.delete(subscriptionId);
      unsubscribers.forEach(unsub => unsub());
    };
  }

  async publish(event: DomainEvent): Promise<void> {
    // Store in history
    this.history.push(event);
    if (this.history.length > this.maxHistorySize) {
      this.history.shift();
    }

    // Execute middleware chain
    const executeMiddleware = async (index: number): Promise<void> => {
      if (index >= this.middlewares.length) {
        await this.executeHandlers(event);
        return;
      }
      await this.middlewares[index](event, () => executeMiddleware(index + 1));
    };

    await executeMiddleware(0);
  }

  async publishMany(events: DomainEvent[]): Promise<void> {
    for (const event of events) {
      await this.publish(event);
    }
  }

  getHistory(eventType?: string): DomainEvent[] {
    if (eventType) {
      return this.history.filter(e => e.eventType === eventType);
    }
    return [...this.history];
  }

  clearHistory(): void {
    this.history = [];
  }

  private async executeHandlers(event: DomainEvent): Promise<void> {
    const subscriptions = this.subscriptions.get(event.eventType) || [];
    const allSubscriptions = this.subscriptions.get('all') || [];
    
    const allHandlers = [...subscriptions, ...allSubscriptions];

    const results = await Promise.allSettled(
      allHandlers.map(async (sub) => {
        if (sub.filter && !sub.filter(event)) {
          return;
        }
        
        try {
          await sub.handler(event);
        } finally {
          if (sub.once) {
            this.unsubscribe(event.eventType, sub.id);
          }
        }
      })
    );

    // Log errors but don't throw
    results.forEach((result, index) => {
      if (result.status === 'rejected') {
        console.error(`Event handler ${index} failed:`, result.reason);
      }
    });
  }

  private unsubscribe(eventType: string, subscriptionId: string): void {
    const subscriptions = this.subscriptions.get(eventType);
    if (subscriptions) {
      const index = subscriptions.findIndex(sub => sub.id === subscriptionId);
      if (index !== -1) {
        subscriptions.splice(index, 1);
      }
    }
  }
}

// Global event bus instance
export const globalEventBus = new EventBus({ maxHistorySize: 10000 });
